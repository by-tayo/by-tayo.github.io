---
import { site } from '../data/site'
import AsciiName from './AsciiName'
import ContactForm from './ContactForm'
import { BoxIcon, FlagIcon, GitHubIcon, LinkedInIcon, MailIcon, MapPinIcon } from './icons'

type Row = { Icon: (p: { className?: string }) => unknown; label: string; href?: string }

const primary: Row[] = [
  { Icon: MailIcon, label: site.email, href: `mailto:${site.email}` },
  { Icon: MapPinIcon, label: site.location },
]
const social: Row[] = [
  { Icon: GitHubIcon, label: 'GitHub', href: site.socials.github },
  { Icon: LinkedInIcon, label: 'LinkedIn', href: site.socials.linkedin },
  { Icon: FlagIcon, label: 'TryHackMe', href: site.socials.tryhackme },
  // Hack The Box stays hidden until a profile link is added in src/data/site.ts.
  { Icon: BoxIcon, label: 'Hack The Box', href: (site.socials.hackthebox as string) || undefined },
].filter((r) => r.label !== 'Hack The Box' || r.href)

const isExternal = (href: string) => href.startsWith('http')
---

<section id="contact" class="border-t border-[var(--line)] px-5 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl">
    <h2 class="sr-only">Contact</h2>
    <div aria-hidden="true" class="mx-auto w-full max-w-xs sm:max-w-xl md:max-w-2xl">
      <AsciiName client:visible={{ rootMargin: '300px' }} text="Contact" charPx={11} />
    </div>

    <div data-reveal="slow" class="mt-12 grid gap-12 sm:grid-cols-2 sm:gap-12 md:gap-16">
      <div>
        <p class="font-mono text-sm uppercase tracking-[0.24em] text-[var(--fg)]">Get in touch</p>
        <p class="mt-3 max-w-sm text-[15px] leading-relaxed text-[var(--muted)]">
          Here&rsquo;s how you can reach out directly.
        </p>

        {
          [
            { rows: primary, cls: 'mt-7 space-y-3' },
            { rows: social, cls: 'mt-6 flex flex-wrap gap-x-8 gap-y-3' },
          ].map(({ rows, cls }) => (
            <ul class={cls}>
              {rows.map(({ Icon, label, href }) => (
                <li>
                  {href ? (
                    <a
                      href={href}
                      target={isExternal(href) ? '_blank' : undefined}
                      rel={isExternal(href) ? 'noopener noreferrer' : undefined}
                      class="flex items-center gap-3 text-[var(--muted)] transition hover:text-[var(--fg)]"
                    >
                      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-[var(--line)]">
                        <Icon className="h-4 w-4" />
                      </span>
                      <span class="text-sm">{label}</span>
                    </a>
                  ) : (
                    <span class="flex items-center gap-3 text-[var(--muted)]">
                      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-[var(--line)]">
                        <Icon className="h-4 w-4" />
                      </span>
                      <span class="text-sm">{label}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ))
        }

        <a
          href={site.socials.tryhackme}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-block rounded-lg transition hover:opacity-85"
        >
          <img
            src={site.tryhackmeBadge}
            alt="TryHackMe profile badge for bytayo: level, rank, streak, badges and rooms completed"
            width="329"
            height="88"
            loading="lazy"
            class="h-auto w-full max-w-[329px] rounded-lg"
          />
        </a>
      </div>

      <ContactForm client:visible={{ rootMargin: '200px' }} />
    </div>
  </div>
</section>
